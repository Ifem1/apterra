{
  "name": "apterra",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node --test test/frontend-*.test.mjs",
    "test:e2e": "playwright test",
    "assert:studio-dev": "node scripts/assert-studio-dev-only.mjs",
    "lint": "npm run assert:studio-dev && eslint app src test scripts e2e playwright.config.ts --max-warnings=0 && npm run typecheck"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.25",
    "@playwright/test": "1.62.0",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "9.39.5",
    "genlayer": "0.40.0-rc.3",
    "genlayer-js": "2.0.0-rc.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
